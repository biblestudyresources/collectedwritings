---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { loadArticles, slugOf, articleUrl, volumeUrl } from '../../lib/library';

export async function getStaticPaths() {
  const all = await loadArticles();
  const eiligNachId = new Map((await getCollection('eilig')).map((e) => [e.id, e]));
  return all.map((article) => {
    const sameVolume = all.filter((a) => a.data.volume === article.data.volume);
    const j = sameVolume.indexOf(article);
    return {
      params: { slug: slugOf(article.data.id) },
      props: { article, eilig: eiligNachId.get(article.data.id) ?? null, prev: sameVolume[j - 1] ?? null, next: sameVolume[j + 1] ?? null },
    };
  });
}
const { article, eilig, prev, next } = Astro.props;
const { Content } = await render(article);
const d = article.data;

// Kurzfassung „Für den eiligen Leser“ (gibt es nur, wenn der Abschnitt in Notion ausgefüllt war)
const EiligContent = eilig ? (await render(eilig)).Content : null;
---
<Base title={`${d.title} – Band ${d.volume}`} currentVolume={d.volume} currentId={d.id}>
  <article data-pagefind-body>                                    <!-- 1 -->
    <header class="article-head">
      <p class="muted" data-pagefind-ignore><a href={volumeUrl(d.volume)}>Band {d.volume}: {d.volumeTitle}</a></p>   <!-- 2 -->
      <h1>{d.title}</h1>
      <TagList tags={d.tags} />
      <p class="article-actions" data-pagefind-ignore>            <!-- 3 -->
        <button type="button" onclick="window.print()">Drucken oder als PDF speichern</button>
      </p>
    </header>
    {EiligContent && (
      <aside class="eilig" aria-labelledby="eilig-titel" data-pagefind-ignore>   <!-- 4 -->
        <h2 id="eilig-titel">Für den eiligen Leser</h2>
        <p class="muted">Zusammenfassung der Redaktion, nicht von J. N. Darby.</p>
        <div class="prose"><EiligContent /></div>
      </aside>
    )}
    <div class="prose"><Content /></div>
  </article>
  <nav class="article-nav" aria-label="Weitere Artikel in diesem Band">
    {prev ? <a rel="prev" href={articleUrl(prev)}>Zurück: {prev.data.title}</a> : <span />}
    {next ? <a rel="next" href={articleUrl(next)}>Weiter: {next.data.title}</a> : <span />}
  </nav>
</Base>
