{
  "name": "darby-bibliothek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/validate.mjs content-test",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "long": "node scripts/make-long-article.mjs",
    "notion:test": "node --env-file-if-exists=.env scripts/notion-test.mjs",
    "fetch:notion": "node --env-file-if-exists=.env scripts/fetch-notion.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "astro": "7.4.2"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
